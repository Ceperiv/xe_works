PORT=3000
APP_ROLE=api
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@postgres:5432/app_ads
REDIS_URL=redis://redis:6379

MARKETPLACE_CONCURRENCY=10
ADS_TXT_CONCURRENCY=25

HTTP_TIMEOUT_MS=5000
HTTP_MAX_RESPONSE_SIZE=262144
HTTP_RETRY_LIMIT=3
HTTP_RETRY_BASE_DELAY_MS=250
HTTP_REDIRECT_LIMIT=5

GLOBAL_RATE_LIMIT=50
PER_DOMAIN_RATE_LIMIT=2
RATE_LIMIT_SLOT_TTL_MS=15000
RATE_LIMIT_ACQUIRE_TIMEOUT_MS=5000
RATE_LIMIT_POLL_MS=100

QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=1000

SCHEDULER_POLL_INTERVAL_MS=10000
SCHEDULER_BATCH_SIZE=200
SCHEDULER_LOCK_TTL_MS=30000
