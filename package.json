{
  "name": "app-ads-scraper-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented prototype for app-ads.txt scraping",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:api": "cross-env APP_ROLE=api tsx src/main.ts",
    "start:worker": "cross-env APP_ROLE=worker tsx src/main.ts",
    "start:scheduler": "cross-env APP_ROLE=scheduler tsx src/main.ts",
    "start:dev": "cross-env APP_ROLE=api tsx watch src/main.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "tsc -p tsconfig.build.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "bullmq": "^5.58.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cross-env": "^7.0.3",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
